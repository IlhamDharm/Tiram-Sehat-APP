# ── Application ──────────────────────────────────────
APP_ENV=development
PORT=8000

# ── Database (Neon PostgreSQL) ───────────────────────
# Dipakai backend FastAPI baru (app/core/config.py).
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require

# Alias lama untuk entrypoint legacy backend/main.py (scan Cloudinary → Neon).
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-long-secret-key
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
PIN_HASH_ROUNDS=12

# ── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
CLOUDINARY_UPLOAD_PRESET=tiramsehat_uploads
CLOUDINARY_FOLDER=tiramsehat

# ── Hugging Face Space (ML Inference) ────────────────
HF_SPACE_URL=https://your-space.hf.space
HF_INTERNAL_SECRET=change-me
HF_TIMEOUT_SECONDS=60
HF_MAX_RETRIES=3

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=*
